  <step>
    <name>normaliza_periodo</name>
    <type>Formula</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <formula>
      <field_name>anio</field_name>
      <formula_string>VALUE(LEFT([PERIODO];4))</formula_string>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field></replace_field>
    </formula>
    <formula>
      <field_name>semestre</field_name>
      <formula_string>IF(RIGHT([PERIODO];1)="1";1;2)</formula_string>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field></replace_field>
    </formula>
    <formula>
      <field_name>periodo_recodificado</field_name>
      <formula_string>IF(RIGHT([PERIODO];1)="4";1;0)</formula_string>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field></replace_field>
    </formula>
