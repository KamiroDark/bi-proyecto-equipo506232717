      <method>none</method>
      <schema_name/>
    </partitioning>
    <formula>
      <field_name>campos_por_corregir</field_name>
      <formula_string>IF(ISBLANK([genero]);1;0)+IF(ISBLANK([tiene_internet]);1;0)+IF(ISBLANK([tiene_computador]);1;0)+IF(ISBLANK([educacion_madre]);1;0)+IF(ISBLANK([educacion_padre]);1;0)+IF(ISBLANK([estrato_vivienda]);1;IF([estrato_vivienda]="Sin Estrato";1;0))</formula_string>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field></replace_field>
    </formula>
