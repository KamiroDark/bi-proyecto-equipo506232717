    </formula>
    <formula>
      <field_name>latitud</field_name>
      <formula_string>(2.0 * Math.atan(Math.exp(Double.parseDouble(y) / 6378137.0)) - Math.PI / 2.0) * 180.0 / Math.PI</formula_string>
      <value_type>Number</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
